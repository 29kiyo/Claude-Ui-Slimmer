{
  "manifest_version": 3,
  "name": "Claude UI Slimmer",
  "version": "1.2.0",
  "description": "claude.aiの添付ファイルサムネイルと入力欄の自動拡張を抑制し、出力内容を見やすくする拡張機能",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
